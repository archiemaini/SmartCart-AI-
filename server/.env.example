# ─────────────────────────────────────────────────────────────
# SmartCart AI — server environment
# Copy this file to `.env` and fill in real values:
#   cp .env.example .env
# ─────────────────────────────────────────────────────────────

# Port the Express API listens on. The Vite dev server proxies /api here.
# Note: 5000 is taken by AirPlay Receiver on macOS, hence 5001 as the default.
PORT=5001

# Node environment: development | production
NODE_ENV=development

# ── MongoDB ──────────────────────────────────────────────────
# Local:  mongodb://127.0.0.1:27017/smartcart
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/smartcart?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/smartcart

# ── Auth ─────────────────────────────────────────────────────
# Secret used to sign JWTs. Use a long random string in production, e.g.
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_me_with_a_long_random_secret
# Token lifetime (zeit/ms format: 30d, 12h, 900s ...)
JWT_EXPIRES_IN=30d

# ── Google Gemini (AI shopping assistant) ────────────────────
# Get a key at https://aistudio.google.com/app/apikey
# If this is left blank the /api/chat route still works — it falls back to a
# local rule-based parser so the app is fully demo-able without a key.
GEMINI_API_KEY=
# Model used for constraint extraction.
GEMINI_MODEL=gemini-2.0-flash

# ── Razorpay (payments, test mode) ────────────────────────────
# Dashboard → Settings → API Keys → Generate Test Key.
# Test keys start with rzp_test_. NEVER commit the secret, and never expose it
# to the browser — the client receives only the key id, from /api/payment/health.
# Leave blank to disable checkout; the app still runs and the Pay button hides.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Razorpay settles in INR for Indian accounts. Charges are sent in paise.
RAZORPAY_CURRENCY=INR

# ── Order pricing ─────────────────────────────────────────────
# Defaults suit the curated USD catalogue. If you load the Kaggle Amazon
# dataset (priced in ₹), raise these to sensible rupee values and set
# VITE_CURRENCY=INR in client/.env — e.g. 0.18 / 5000 / 99.
TAX_RATE=0.08
FREE_SHIPPING_THRESHOLD=75
FLAT_SHIPPING=6.99

# ── CORS ─────────────────────────────────────────────────────
# Comma-separated list of allowed browser origins for the client app.
CLIENT_ORIGIN=http://localhost:5173
