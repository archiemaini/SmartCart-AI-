# ─────────────────────────────────────────────────────────────
# SmartCart — client environment (all Vite vars must start VITE_)
# Copy to .env:  cp .env.example .env
# Everything here is OPTIONAL; the defaults suit the curated USD catalogue.
# ─────────────────────────────────────────────────────────────

# Currency the storefront prints. USD | INR
# Set INR when you seed the Kaggle Amazon dataset (npm run seed:kaggle),
# whose prices are rupees. Razorpay also settles in INR.
VITE_CURRENCY=USD

# Cart summary maths — must mirror server/.env, since the server recomputes
# every total at checkout and its numbers are the ones actually charged.
VITE_TAX_RATE=0.08
VITE_FREE_SHIPPING_THRESHOLD=75
VITE_FLAT_SHIPPING=6.99
